rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isSelf(userId) { return signedIn() && request.auth.uid == userId; }

    match /admins/{adminId} {
      allow read: if isSelf(adminId);
      allow write: if false;
    }

    // users/{uid} — the full private profile: only its owner and the organizer can read it.
    // The owner can only store a JPEG photo (as produced by the site) and their own login email.
    function isValidProfile(d) {
      return (!('photoDataUrl' in d) ||
                (d.photoDataUrl is string && d.photoDataUrl.size() < 230000 &&
                 d.photoDataUrl.matches('data:image/jpeg;base64,.*'))) &&
             (!('email' in d) || d.email == request.auth.token.email);
    }
    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow create, update: if isSelf(userId) && isValidProfile(request.resource.data);
      allow delete: if isSelf(userId);
    }

    match /letters/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow write: if isAdmin();
    }

    // abstracts/{uid} — opened by the organizer, so only a Word file data URL is accepted
    // (never anything a browser could run).
    function isValidAbstract(d) {
      return d.keys().hasOnly(['abstractDataUrl', 'fileName', 'uploadedAt']) &&
             d.abstractDataUrl is string && d.abstractDataUrl.size() < 420000 &&
             d.abstractDataUrl.matches('data:application/(msword|vnd[.]openxmlformats-officedocument[.]wordprocessingml[.]document|octet-stream);base64,.*') &&
             d.fileName is string && d.fileName.size() < 300;
    }
    match /abstracts/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow create, update: if isSelf(userId) && isValidAbstract(request.resource.data);
      allow delete: if isSelf(userId);
    }

    // speakers/{uid} = { talkId } — set by the organizer in the Subscribers panel
    match /speakers/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow write: if isAdmin();
    }

    // presentations/{talkId} (+ its chunks) — a talk's slides: any signed-in user can
    // download, only that talk's assigned speaker (or the organizer) can upload/replace
    function canUploadSlides(talkId) {
      return isAdmin() ||
             (signedIn() && get(/databases/$(database)/documents/speakers/$(request.auth.uid)).data.talkId == talkId);
    }
    function isValidSlidesMeta(d) {
      return d.keys().hasOnly(['fileName', 'mimeType', 'size', 'chunkCount', 'uploadedBy', 'uploadedAt']) &&
             d.fileName is string && d.fileName.size() < 300 &&
             d.mimeType is string && d.mimeType.size() < 120 &&
             d.chunkCount is int && d.chunkCount >= 1 && d.chunkCount <= 120 &&
             d.uploadedBy == request.auth.uid;
    }
    match /presentations/{talkId} {
      allow read: if signedIn();
      allow create, update: if canUploadSlides(talkId) && isValidSlidesMeta(request.resource.data);
      allow delete: if canUploadSlides(talkId);
      match /chunks/{chunkId} {
        allow read: if signedIn();
        allow create, update: if canUploadSlides(talkId) && chunkId.matches('[0-9]{1,3}') &&
                                 request.resource.data.keys().hasOnly(['data']) &&
                                 request.resource.data.data is bytes &&
                                 request.resource.data.data.size() <= 921600;
        allow delete: if canUploadSlides(talkId);
      }
    }

    // directory/{uid} — the only profile data other participants can see: name, email,
    // phone and affiliation. Readable by any signed-in user; written by the owner (with their
    // own login email) or the organizer, with exactly these short text fields and nothing else.
    function isDirectoryEntry(d) {
      return d.keys().hasOnly(['fullName', 'email', 'phone', 'institution', 'updatedAt']) &&
             d.fullName is string && d.fullName.size() < 200 &&
             d.email is string && d.email.size() < 200 &&
             d.phone is string && d.phone.size() < 60 &&
             d.institution is string && d.institution.size() < 300 &&
             d.updatedAt is string && d.updatedAt.size() < 40;
    }
    match /directory/{userId} {
      allow read: if signedIn();
      allow create, update: if isDirectoryEntry(request.resource.data) &&
                               (isAdmin() ||
                                (isSelf(userId) && request.resource.data.email == request.auth.token.email));
      allow delete: if isSelf(userId) || isAdmin();
    }

    // settings/photos = { driveUrl } and settings/feedback = { feedbackUrl } — the shared photo
    // folder and the anonymous feedback form: signed-in users can read them, only the
    // organizer can set them, and only to a Google Drive / Google Forms https link.
    match /settings/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin() && docId in ['photos', 'feedback'] &&
                      request.resource.data.keys().hasOnly(['driveUrl', 'feedbackUrl', 'updatedAt']) &&
                      (!('driveUrl' in request.resource.data) ||
                        request.resource.data.driveUrl.matches('(https://(drive|photos)[.]google[.]com/.*)?')) &&
                      (!('feedbackUrl' in request.resource.data) ||
                        request.resource.data.feedbackUrl.matches('(https://(docs[.]google[.]com/forms/|forms[.]gle/).*)?'));
    }

    // gallery/{imageId} (+ its chunks) — workshop photos: any signed-in user can view,
    // only the organizer can add or delete
    match /gallery/{imageId} {
      allow read: if signedIn();
      allow write: if isAdmin();
      match /chunks/{chunkId} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }
    }
  }
}
