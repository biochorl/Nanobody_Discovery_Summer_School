rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isSelf(userId) { return signedIn() && request.auth.uid == userId; }

    match /admins/{adminId} {
      allow read: if isSelf(adminId);
      allow write: if false;
    }

    // users/{uid} — the full private profile: only its owner and the organizer can read it.
    // The owner can only store a JPEG photo (as produced by the site) and their own login email.
    function isValidProfile(d) {
      return (!('photoDataUrl' in d) ||
                (d.photoDataUrl is string && d.photoDataUrl.size() < 230000 &&
                 d.photoDataUrl.matches('data:image/jpeg;base64,.*'))) &&
             (!('email' in d) || d.email == request.auth.token.email);
    }
    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow create, update: if isSelf(userId) && isValidProfile(request.resource.data);
      allow delete: if isSelf(userId);
    }

    match /letters/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow write: if isAdmin();
    }

    // abstracts/{uid} — opened by the organizer, so only a Word file data URL is accepted
    // (never anything a browser could run).
    function isValidAbstract(d) {
      return d.keys().hasOnly(['abstractDataUrl', 'fileName', 'uploadedAt']) &&
             d.abstractDataUrl is string && d.abstractDataUrl.size() < 420000 &&
             d.abstractDataUrl.matches('data:application/(msword|vnd[.]openxmlformats-officedocument[.]wordprocessingml[.]document|octet-stream);base64,.*') &&
             d.fileName is string && d.fileName.size() < 300;
    }
    match /abstracts/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow create, update: if isSelf(userId) && isValidAbstract(request.resource.data);
      allow delete: if isSelf(userId);
    }

    // speakers/{uid} = { talkId } — set by the organizer in the Subscribers panel
    match /speakers/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow write: if isAdmin();
    }

    // presentations/{talkId} (+ its chunks) — a talk's slides: any signed-in user can
    // download, only that talk's assigned speaker (or the organizer) can upload/replace
    function canUploadSlides(talkId) {
      return isAdmin() ||
             (signedIn() && get(/databases/$(database)/documents/speakers/$(request.auth.uid)).data.talkId == talkId);
    }
    function isValidSlidesMeta(d) {
      return d.keys().hasOnly(['fileName', 'mimeType', 'size', 'chunkCount', 'uploadedBy', 'uploadedAt']) &&
             d.fileName is string && d.fileName.size() < 300 &&
             d.mimeType is string && d.mimeType.size() < 120 &&
             d.chunkCount is int && d.chunkCount >= 1 && d.chunkCount <= 120 &&
             d.uploadedBy == request.auth.uid;
    }
    match /presentations/{talkId} {
      allow read: if signedIn();
      allow create, update: if canUploadSlides(talkId) && isValidSlidesMeta(request.resource.data);
      allow delete: if canUploadSlides(talkId);
      match /chunks/{chunkId} {
        allow read: if signedIn();
        allow create, update: if canUploadSlides(talkId) && chunkId.matches('[0-9]{1,3}') &&
                                 request.resource.data.keys().hasOnly(['data']) &&
                                 request.resource.data.data is bytes &&
                                 request.resource.data.data.size() <= 921600;
        allow delete: if canUploadSlides(talkId);
      }
    }

    // directory/{uid} — the only profile data other participants can see: name, email,
    // phone and affiliation. Readable by any signed-in user; written by the owner (with their
    // own login email) or the organizer, with exactly these short text fields and nothing else.
    function isDirectoryEntry(d) {
      return d.keys().hasOnly(['fullName', 'email', 'phone', 'institution', 'updatedAt']) &&
             d.fullName is string && d.fullName.size() < 200 &&
             d.email is string && d.email.size() < 200 &&
             d.phone is string && d.phone.size() < 60 &&
             d.institution is string && d.institution.size() < 300 &&
             d.updatedAt is string && d.updatedAt.size() < 40;
    }
    match /directory/{userId} {
      allow read: if signedIn();
      allow create, update: if isDirectoryEntry(request.resource.data) &&
                               (isAdmin() ||
                                (isSelf(userId) && request.resource.data.email == request.auth.token.email));
      allow delete: if isSelf(userId) || isAdmin();
    }

    // settings/photos = { driveUrl } — the shared photo folder link: signed-in users can read
    // it, only the organizer can set it, and only to a Google Drive / Photos https link.
    match /settings/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin() && docId == 'photos' &&
                      request.resource.data.keys().hasOnly(['driveUrl', 'updatedAt']) &&
                      request.resource.data.driveUrl.matches('(https://(drive|photos)[.]google[.]com/.*)?');
    }

    // feedback/{id} — anonymous answers (no uid/name/email is stored). Any signed-in user can
    // add one well-formed answer; only the organizer can read or delete them; nobody edits them.
    // Must match FEEDBACK_QUESTIONS in auth.js.
    function fbScale(d, k) { return !(k in d) || (d[k] is int && d[k] >= 1 && d[k] <= 5); }
    function fbText(d, k) { return !(k in d) || (d[k] is string && d[k].size() > 0 && d[k].size() <= 3000); }
    function fbPick(d, k, opts) { return !(k in d) || d[k] in opts; }
    function isValidFeedback(d) {
      return d.keys().hasOnly(['v', 'role', 'overall', 'liked', 'improve', 'sessions', 'skip',
                               'balance', 'expectations', 'panning', 'talksUseful', 'ects',
                               'communication', 'venues', 'accommodation', 'catering', 'social',
                               'website', 'logistics', 'engagement', 'adjust',
                               'recommend', 'topics', 'comments']) &&
             d.v == 1 && d.role in ['Participant', 'Speaker', 'Organizer'] &&
             fbScale(d, 'overall') && fbScale(d, 'expectations') && fbScale(d, 'panning') &&
             fbScale(d, 'talksUseful') && fbScale(d, 'communication') && fbScale(d, 'venues') &&
             fbScale(d, 'catering') && fbScale(d, 'social') && fbScale(d, 'website') &&
             fbScale(d, 'engagement') &&
             (!('accommodation' in d) || (d.accommodation is int && d.accommodation >= 0 && d.accommodation <= 5)) &&
             fbText(d, 'liked') && fbText(d, 'improve') && fbText(d, 'skip') && fbText(d, 'logistics') &&
             fbText(d, 'adjust') && fbText(d, 'topics') && fbText(d, 'comments') &&
             fbPick(d, 'balance', ['Too theoretical', 'Balanced', 'Too practical']) &&
             fbPick(d, 'ects', ['Too light', 'About right', 'Too heavy']) &&
             fbPick(d, 'recommend', ['Yes', 'Maybe', 'No']) &&
             (!('sessions' in d) || (d.sessions is list && d.sessions.size() >= 1 && d.sessions.size() <= 3 &&
               d.sessions.hasOnly(['intro', 'insilico', 'denovo', 'panningBriefing', 'lab', 'talks',
                                   'fortuna', 'hadzi'])));
    }
    // One anonymous answer per account ("ballots"): each account is issued ballots/{uid} once
    // (ballotIssued/{uid} records that it was issued, so it can't be issued again). An answer is
    // only accepted if it uses up (deletes) the sender's ballot in the same batch; the answer
    // itself carries no uid. Only the account itself can read its ballot documents.
    match /feedback/{id} {
      allow create: if signedIn() && !isAdmin() && isValidFeedback(request.resource.data) &&
                       exists(/databases/$(database)/documents/ballots/$(request.auth.uid)) &&
                       // the answer's id must be the ballot's one-time token: one ballot = one answer,
                       // even if several answers are packed into the batch that uses it up
                       get(/databases/$(database)/documents/ballots/$(request.auth.uid)).data.t == id &&
                       !existsAfter(/databases/$(database)/documents/ballots/$(request.auth.uid));
      allow read, delete: if isAdmin();
      allow update: if false;
    }
    match /ballotIssued/{userId} {
      allow read: if isSelf(userId);
      allow create: if isSelf(userId) && request.resource.data.keys().size() == 0 &&
                       existsAfter(/databases/$(database)/documents/ballots/$(userId));
      allow update, delete: if false; // the organizer can remove one in the Firebase console to re-allow
    }
    match /ballots/{userId} {
      allow read: if isSelf(userId);
      allow create: if isSelf(userId) && request.resource.data.keys().hasOnly(["t"]) &&
                       request.resource.data.t is string && request.resource.data.t.matches("[A-Za-z0-9]{20}") &&
                       !exists(/databases/$(database)/documents/ballotIssued/$(userId)) &&
                       existsAfter(/databases/$(database)/documents/ballotIssued/$(userId));
      allow delete: if isSelf(userId);
      allow update: if false;
    }
    // feedbackTest/{id} — the organizer's own test answers: unlimited, never mixed with real ones.
    match /feedbackTest/{id} {
      allow create: if isAdmin() && isValidFeedback(request.resource.data);
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // gallery/{imageId} (+ its chunks) — workshop photos: any signed-in user can view,
    // only the organizer can add or delete
    match /gallery/{imageId} {
      allow read: if signedIn();
      allow write: if isAdmin();
      match /chunks/{chunkId} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }
    }
  }
}
